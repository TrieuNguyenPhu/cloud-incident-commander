{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cic.example/schemas/ApprovalDecisionEvent.schema.json",
  "title": "ApprovalDecisionEvent",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "event_id": {
      "type": "string"
    },
    "approval_id": {
      "type": "string"
    },
    "action_id": {
      "type": "string"
    },
    "requester_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "approval_id",
    "action_id",
    "requester_id",
    "actor_id",
    "decision",
    "decided_at",
    "policy_version",
    "expected_version"
  ]
}
